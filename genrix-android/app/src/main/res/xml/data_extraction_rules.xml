<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or moved to a new device: the encrypted key can't be
     decrypted there anyway (its Keystore key never leaves this phone). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
